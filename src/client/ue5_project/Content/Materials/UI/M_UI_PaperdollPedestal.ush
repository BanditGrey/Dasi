// ============================================================================
// DASI MMORPG - UNREAL ENGINE 5 UI MATERIAL HLSL INCLUDE
// M_UI_PaperdollPedestal.ush
//
// 100% 3D Native PBR Pedestal Material for Paperdoll & Item 3D Inspector.
// Features:
//   - Polished Obsidian Black Marble with radial anisotropic micro-scratches.
//   - Deep Gothic Runic Ring carvings evaluated via Parallax Occlusion Mapping (POM).
//   - Dynamic breathing golden emissive pulse resonating with item refinement tiers.
//   - Sharp Lumen mirror reflections for character boots & weapon silhouettes.
//
// Included inside UE5 Material Custom HLSL Nodes:
//   #include "/Project/Materials/UI/M_UI_PaperdollPedestal.ush"
// ============================================================================

#ifndef M_UI_PAPERDOLL_PEDESTAL_USH
#define M_UI_PAPERDOLL_PEDESTAL_USH

static const float PEDESTAL_PI = 3.14159265359f;

// ----------------------------------------------------------------------------
// STRUCTURE FOR PEDESTAL PBR OUTPUT
// ----------------------------------------------------------------------------
struct FPedestalMasterOutput
{
	float3 BaseColor;
	float3 WorldNormal;
	float3 EmissiveColor;
	float  Metallic;
	float  Specular;
	float  Roughness;
	float  Anisotropy;
	float3 Tangent;
};

// ----------------------------------------------------------------------------
// PARALLAX OCCLUSION MAPPING (POM) FOR DEEP RUNIC CARVINGS
// Ray-marches through heightmap layer to displace runes into the marble floor.
// ----------------------------------------------------------------------------
float2 Pedestal_ParallaxOcclusionMapping(
	float2 UV,
	float3 ViewDirTS,              // View vector in Tangent Space
	Texture2D HeightTex,
	SamplerState SamplerLinear,
	float HeightScale,
	int MinSamples,
	int MaxSamples,
	out float OutParallaxDepth)
{
	// Scale number of steps based on viewing angle (more steps at grazing angles)
	float numSteps = lerp((float)MaxSamples, (float)MinSamples, saturate(abs(ViewDirTS.z)));
	float stepSize = 1.0f / numSteps;
	
	// Ray direction in UV space
	float2 p = ViewDirTS.xy * HeightScale;
	float2 deltaUV = p / numSteps;

	float2 currentUV = UV;
	float currentLayerDepth = 0.0f;
	float currentHeight = HeightTex.Sample(SamplerLinear, currentUV).r;

	// March ray downward until height exceeds layer depth
	[loop]
	while (currentLayerDepth < currentHeight)
	{
		currentUV -= deltaUV;
		currentHeight = HeightTex.Sample(SamplerLinear, currentUV).r;
		currentLayerDepth += stepSize;
	}

	// Parallax Occlusion interpolation between previous and current step
	float2 prevUV = currentUV + deltaUV;
	float nextDepth = currentHeight - currentLayerDepth;
	float prevDepth = HeightTex.Sample(SamplerLinear, prevUV).r - currentLayerDepth + stepSize;

	float weight = nextDepth / (nextDepth - prevDepth);
	float2 finalUV = lerp(currentUV, prevUV, weight);
	OutParallaxDepth = currentLayerDepth;

	return finalUV;
}

// ----------------------------------------------------------------------------
// RADIAL ANISOTROPIC TANGENT GENERATION
// Aligns anisotropic micro-scratches along concentric rings around pedestal center
// ----------------------------------------------------------------------------
float3 ComputeRadialAnisotropicTangent(float2 UV, float3 WorldNormal)
{
	// UV centered at (0.5, 0.5)
	float2 centeredUV = UV - float2(0.5f, 0.5f);
	
	// Perpendicular tangent vector along concentric circles: (-y, x)
	float2 tangent2D = normalize(float2(-centeredUV.y, centeredUV.x));

	// Project tangent onto tangent plane perpendicular to WorldNormal
	float3 arbitraryUp = float3(0.0f, 0.0f, 1.0f);
	if (abs(WorldNormal.z) > 0.99f)
	{
		arbitraryUp = float3(0.0f, 1.0f, 0.0f);
	}
	float3 tangentX = normalize(cross(arbitraryUp, WorldNormal));
	float3 tangentY = cross(WorldNormal, tangentX);

	float3 radialTangent = normalize(tangentX * tangent2D.x + tangentY * tangent2D.y);
	return radialTangent;
}

// ----------------------------------------------------------------------------
// PROCEDURAL GOTHIC RUNIC RING GENERATOR (FALLBACK OR TEXTURE ENHANCER)
// ----------------------------------------------------------------------------
float EvaluateGothicRunicRing(
	float2 UV,
	float  GlobalTime,
	float  RefinementTier, // [0 to 15]
	out float OutRuneActivePulse)
{
	float2 p = UV - float2(0.5f, 0.5f);
	float r = length(p) * 2.0f; // Radius normalized to 0.0 at center, 1.0 at outer edge
	float theta = atan2(p.y, p.x); // Angle in radians [-PI .. +PI]

	// 1. Concentric Runic Bands
	// Band A: Outer intricate border ring [0.82 to 0.88]
	float outerBand = smoothstep(0.81f, 0.83f, r) * (1.0f - smoothstep(0.87f, 0.89f, r));
	
	// Band B: Main runic glyph canal [0.65 to 0.78]
	float runeCanal = smoothstep(0.64f, 0.66f, r) * (1.0f - smoothstep(0.77f, 0.79f, r));

	// Band C: Inner sacred geometry compass [0.38 to 0.44]
	float innerBand = smoothstep(0.37f, 0.39f, r) * (1.0f - smoothstep(0.43f, 0.45f, r));

	// 2. High-frequency Runic Notches along perimeter (16 cardinal glyph stations)
	float glyphFrequency = 16.0f;
	float glyphAngle = theta * glyphFrequency;
	float glyphNotch = abs(sin(glyphAngle)) * abs(cos(glyphAngle * 2.5f));
	float carvedRunes = runeCanal * smoothstep(0.25f, 0.70f, glyphNotch);

	// 3. Central Octagram Star knotwork
	float octagram = abs(cos(theta * 4.0f)) * (1.0f - smoothstep(0.0f, 0.42f, r));
	float starLines = smoothstep(0.70f, 0.90f, octagram) * step(0.10f, r);

	float compositeCarving = saturate(outerBand * 0.7f + carvedRunes + innerBand * 0.6f + starLines * 0.85f);

	// 4. Harmonic Breathing Pulse
	// Idle breathing at 1.2 rad/s; speeds up if inspected item is high tier (+13 to +15)
	float pulseSpeed = 1.2f + (RefinementTier / 15.0f) * 2.2f;
	float breath = sin(GlobalTime * pulseSpeed) * 0.5f + 0.5f;

	// Orbiting mystical energy wave traveling clockwise around the ring
	float orbitAngle = frac(GlobalTime * 0.15f) * 2.0f * PEDESTAL_PI;
	float angleDelta = abs(theta - orbitAngle);
	if (angleDelta > PEDESTAL_PI) angleDelta = 2.0f * PEDESTAL_PI - angleDelta;
	float travelingSpark = exp(-angleDelta * 5.0f) * 1.5f;

	OutRuneActivePulse = (breath * 0.7f + 0.3f) + travelingSpark;

	return compositeCarving;
}

// ----------------------------------------------------------------------------
// MASTER EVALUATION FUNCTION FOR OBSIDIAN PEDESTAL
// ----------------------------------------------------------------------------
FPedestalMasterOutput EvaluatePaperdollPedestalMaster(
	float3 WorldPos,
	float3 WorldNormal,
	float3 ViewDirTS,
	float2 UV,
	// Textures
	Texture2D ObsidianAlbedoTex,   // Dark obsidian with delicate calcite veins
	Texture2D ObsidianNormalTex,   // Surface polish micro-facets
	Texture2D RuneHeightMaskTex,   // Deep height carving for runes
	SamplerState SamplerLinear,
	// Parameters
	float  GlobalTime,
	float  RefinementTier,         // Active item refinement tier [0 to 15]
	float  POMHeightScale,         // Depth of rune carvings in UV units (e.g. 0.04)
	float3 CustomRuneColorOverride)
{
	FPedestalMasterOutput Out;

	// 1. Parallax Occlusion Mapping for Deep Runic Carving
	float parallaxDepth;
	float2 pomUV = Pedestal_ParallaxOcclusionMapping(
		UV,
		ViewDirTS,
		RuneHeightMaskTex,
		SamplerLinear,
		POMHeightScale,
		8,   // Min samples
		32,  // Max samples
		parallaxDepth
	);

	// 2. Sample Obsidian Base Textures
	float4 rawAlbedo = ObsidianAlbedoTex.Sample(SamplerLinear, pomUV * 3.0f);
	float4 rawNormal = ObsidianNormalTex.Sample(SamplerLinear, pomUV * 3.0f);

	// Deep Obsidian Black with charcoal/slate mineral veins
	float3 obsidianBase = rawAlbedo.rgb * float3(0.045f, 0.048f, 0.052f);

	// 3. Evaluate Runic Ring Carving & Illumination
	float runePulse;
	float runeCarvingMask = EvaluateGothicRunicRing(pomUV, GlobalTime, RefinementTier, runePulse);

	// Blend with texture height if available
	float texRuneMask = RuneHeightMaskTex.Sample(SamplerLinear, pomUV).r;
	float combinedRuneMask = saturate(runeCarvingMask + texRuneMask * 0.8f);

	// 4. Gold Emissive Resonance
	// Tier 0: Soft dormant gold (#d97706)
	// Tier 9: Bright solar gold (#f59e0b)
	// Tier 13+: Radiant archangel gold with fiery cyan coronas
	float3 baseGoldColor = float3(0.96f, 0.65f, 0.12f);
	if (RefinementTier >= 13.0f)
	{
		baseGoldColor = lerp(baseGoldColor, float3(0.40f, 0.85f, 1.0f), 0.35f);
	}
	if (length(CustomRuneColorOverride) > 0.01f)
	{
		baseGoldColor = CustomRuneColorOverride;
	}

	float emissiveIntensity = (0.8f + (RefinementTier / 15.0f) * 2.8f) * runePulse;
	float3 runeEmission = baseGoldColor * (combinedRuneMask * emissiveIntensity * 2.2f);

	// 5. Normal Perturbation: Carving creates sharp inward bevels
	float3 flatNormal = WorldNormal;
	float3 perturbedNormal = normalize(flatNormal + (rawNormal.xyz * 2.0f - 1.0f) * 0.08f);

	// Inside the rune grooves, the normal dips downward into the stone
	float carvingEdge = saturate(combinedRuneMask * 2.0f);
	Out.WorldNormal = lerp(perturbedNormal, normalize(flatNormal - float3(0.0f, 0.0f, 0.25f)), carvingEdge * 0.4f);

	// 6. Polished Obsidian PBR Surface Properties:
	// Mirror-finish on top surface, matte rough inside the carved grooves
	float isInsideCarving = smoothstep(0.15f, 0.85f, combinedRuneMask);

	Out.BaseColor = lerp(obsidianBase, float3(0.015f, 0.012f, 0.010f), isInsideCarving);
	Out.Metallic = lerp(0.02f, 0.85f, isInsideCarving * 0.6f); // Inlaid gold leaf in grooves
	Out.Specular = lerp(0.95f, 0.35f, isInsideCarving);
	Out.Roughness = lerp(0.045f, 0.45f, isInsideCarving); // Ultra-glossy obsidian floor (0.045)
	Out.EmissiveColor = runeEmission;

	// 7. Radial Anisotropic Reflections
	Out.Anisotropy = 0.65f * (1.0f - isInsideCarving); // Anisotropic circular brush polish
	Out.Tangent = ComputeRadialAnisotropicTangent(pomUV, flatNormal);

	return Out;
}

#endif // M_UI_PAPERDOLL_PEDESTAL_USH
