reference/**/client/
!reference/**/client/.gitkeep
reference/**/*.exe
reference/**/*.dll
reference/**/*.pdb
reference/**/*.lib
reference/**/*.obj
reference/**/*.ilk
reference/**/*.mdf
reference/**/*.ldf
reference/**/.vs/
reference/**/Debug/
reference/**/Release/
reference/**/x64/
reference/**/ipch/
reference/**/Sound/
reference/**/Music/

# Conversões e temporários brutos
conversions/
scratch/
reference/
archive/

# Bancos de dados locais / runtime SQLite
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
