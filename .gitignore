dist/
build/
*.tsbuildinfo

# Logs e Temporários
*.log
.system_generated/
.basinfy/

# Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Bytecode Python (não versionar)
__pycache__/
*.pyc
*.pyo

# Coverage / relatórios de teste
coverage/

